# Copy this file to .env for local development.
# In production these are set as GitHub Actions Secrets (worker jobs)
# and Netlify environment variables (web app): never committed.

# Supabase Postgres connection string (Session pooler recommended for
# short-lived worker jobs, e.g. GitHub Actions; use the direct connection
# string for apps/web if you enable Prisma migrations from Netlify build).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic (article writing)
ANTHROPIC_API_KEY=""

# kie.ai (image generation, nano-banana-edit / seedream models)
KIE_AI_API_KEY=""
KIE_AI_BASE_URL="https://api.kie.ai/api/v1"
# Monthly spend guardrail, in USD. Non-essential jobs (IG story image) are
# skipped once this is exceeded for the current calendar month.
MAX_MONTHLY_IMAGE_SPEND_USD="150"
# Branded 9:16 template PNG (headline overlay) used for the optional IG
# Story image. Leave empty to skip IG Story image generation entirely.
STORY_TEMPLATE_IMAGE_URL=""

# WordPress (beatdagame.com): create under Users > Profile > Application Passwords
WP_BASE_URL="https://www.beatdagame.com"
WP_USERNAME=""
WP_APP_PASSWORD=""
WP_DEFAULT_CATEGORY_ID="6"

# Notifications
SLACK_WEBHOOK_URL=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""
RESEND_API_KEY=""

# apps/web auth (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
