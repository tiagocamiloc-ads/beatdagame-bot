# Copy this file to .env for local development.
# In production these are set as GitHub Actions Secrets (worker jobs)
# and Netlify environment variables (web app): never committed.

# Supabase connection strings: get both from Project (dashboard) -> Connect
# -> ORM tab -> Prisma. Supabase's direct-connection host is IPv6-only, so
# these pooler URLs are required (not optional) for GitHub Actions/Netlify.
#   DATABASE_URL: transaction-mode pooler (port 6543), used for all normal
#     runtime queries.
#   DIRECT_URL: session-mode pooler (port 5432), used only by
#     `prisma migrate deploy`/`dev` (DDL needs a non-pgbouncer connection).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Anthropic (article writing)
ANTHROPIC_API_KEY=""

# kie.ai (image generation, nano-banana-edit / seedream models)
KIE_AI_API_KEY=""
KIE_AI_BASE_URL="https://api.kie.ai/api/v1"
# Monthly spend guardrail, in USD. Non-essential jobs (IG story image) are
# skipped once this is exceeded for the current calendar month.
MAX_MONTHLY_IMAGE_SPEND_USD="150"
# Branded 9:16 template PNG (headline overlay) used for the optional IG
# Story image. Leave empty to skip IG Story image generation entirely.
STORY_TEMPLATE_IMAGE_URL=""

# WordPress (beatdagame.com): create under Users > Profile > Application Passwords
WP_BASE_URL="https://www.beatdagame.com"
WP_USERNAME=""
WP_APP_PASSWORD=""
WP_DEFAULT_CATEGORY_ID="6"

# Notifications
SLACK_WEBHOOK_URL=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""
RESEND_API_KEY=""

# apps/web auth (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
